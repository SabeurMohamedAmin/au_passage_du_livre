# Resend API Key for sending emails
RESEND_API_KEY=your_resend_api_key_here

# Nuxt Auth Session Password (must be at least 32 characters long)
NUXT_SESSION_PASSWORD=your_session_password_must_be_at_least_32_characters_long

# Application URL
APP_URL=http://localhost:3000

# Secret token for database seeding/setup
SEED_SECRET=your_seed_secret_here
